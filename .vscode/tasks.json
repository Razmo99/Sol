    "version": "2.0.0",
    "tasks": [
        {
            "label": "echo",
            "type":  "shell",
            "command": "pwsh"
        },
        {
            "label": "build",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-File",
                "${workspaceFolder}/build.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
